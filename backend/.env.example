# Local development configuration. Copy this file to .env before adding secrets.
APP_NAME=MeetingPilot AI API
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///./meetingpilot.db
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_LOAD_ON_STARTUP=true
